<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.hwani1103.shiftbell.WaveGradientView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:bottomCornerRadius="24dp"
        app:topCornerRadius="24dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_vertical" android:elevation="8dp"
        android:paddingHorizontal="22dp" android:paddingTop="20dp" android:paddingBottom="20dp">
        <TextView android:id="@+id/timeText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="09:30" android:textSize="46sp" android:maxLines="1" android:textColor="#FFFFFF" android:textStyle="bold"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="28sp" android:autoSizeMaxTextSize="46sp"
            android:autoSizeStepGranularity="1sp" android:shadowColor="#40000000" android:shadowDy="1" android:shadowRadius="3" />
        <TextView android:id="@+id/shiftTypeText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="@string/alarm_default_label" android:textSize="16sp" android:textColor="#3B2E7A" android:textStyle="bold"
            android:layout_marginBottom="12dp" android:background="@drawable/overlay_shift_badge" android:padding="8dp" />
<LinearLayout android:id="@+id/buttonContainer" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center">
<Button android:id="@+id/snoozeDecreaseButton" android:layout_width="48dp" android:layout_height="48dp"
    android:minWidth="0dp" android:minHeight="48dp" android:padding="0dp" android:text="−" android:textSize="30sp"
    android:includeFontPadding="false" android:gravity="center" android:stateListAnimator="@null" android:backgroundTint="@null"
    android:textColor="#FFFFFF" android:background="@drawable/alarm_lock_control"
    android:contentDescription="@string/alarm_snooze_decrease" />
<FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp"
    android:layout_marginHorizontal="8dp" android:background="@drawable/alarm_lock_snooze">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:paddingHorizontal="6dp" android:paddingVertical="6dp"
        android:importantForAccessibility="noHideDescendants">
        <TextView android:id="@+id/lockSnoozeTitle" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center" android:text="@string/alarm_snooze_title" android:textSize="16sp"
            android:textColor="#302746" android:textStyle="bold" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/snoozeValueText" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="center" android:text="" android:textSize="18sp"
            android:textColor="#302746" android:textStyle="bold" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <Button android:id="@+id/snoozeButton" android:layout_width="match_parent" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text=""
        android:background="@drawable/alarm_lock_snooze_ripple" android:backgroundTint="@null" android:stateListAnimator="@null"
        android:contentDescription="@string/alarm_snooze_label" />
</FrameLayout><Button android:id="@+id/snoozeIncreaseButton" android:layout_width="48dp" android:layout_height="48dp"
    android:minWidth="0dp" android:minHeight="48dp" android:padding="0dp" android:text="+" android:textSize="30sp"
    android:includeFontPadding="false" android:gravity="center" android:stateListAnimator="@null" android:backgroundTint="@null"
    android:textColor="#FFFFFF" android:background="@drawable/alarm_lock_control"
    android:contentDescription="@string/alarm_snooze_increase" /><Button android:id="@+id/dismissButton" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="8dp"
    android:minWidth="0dp" android:minHeight="48dp" android:padding="0dp" android:text="×" android:textSize="38sp"
    android:includeFontPadding="false" android:gravity="center" android:backgroundTint="@null"
    android:textColor="#FFFFFF" android:background="@drawable/alarm_lock_control" android:stateListAnimator="@null"
    android:contentDescription="@string/alarm_dismiss_label" />
</LinearLayout>
    </LinearLayout>
</FrameLayout>
