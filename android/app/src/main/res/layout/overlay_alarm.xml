<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ 2026-08-25 3차 수정 - "UI 테마" 탭에서 확정한 _overlayCard 구조 그대로:
     카드 하나(그라데이션, 화면 맨 위에 딱 붙음 - AlarmOverlayService.kt의
     gravity=TOP/y=0/width=MATCH_PARENT 확인함)에 [시간+뱃지(왼쪽, 세로로 쌓임)]
     와 [스누즈+끄기 작은 원(오른쪽, 라벨 없음)]이 한 Row로 나란히 들어감 -
     예전처럼 카드 아래에 별도 버튼 줄이 있는 구조가 아님. 바깥 흰 프레임도
     삭제(목업의 회색 배경은 "가짜 배경화면"일 뿐 카드 디자인이 아니었음).
     뷰 ID(timeText/shiftTypeText/dismissButton/snoozeButton)는 그대로 -
     AlarmOverlayService.kt의 findViewById 참조는 안 건드림. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/overlay_card_gradient"
    android:elevation="8dp"
    android:paddingHorizontal="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="16dp">

    <!-- 왼쪽: 시간 + 근무 뱃지 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:30"
            android:textSize="30sp"
            android:textColor="#3B2E7A"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"/>

        <TextView
            android:id="@+id/shiftTypeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="주간"
            android:textSize="12sp"
            android:textColor="#3B2E7A"
            android:textStyle="bold"
            android:background="@drawable/overlay_shift_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"/>
    </LinearLayout>

    <Space android:layout_width="8dp" android:layout_height="1dp"/>

    <!-- 오른쪽: 스누즈 + 끄기 (작은 원, 라벨 없음) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/alarm_snooze_circle"
                android:text="+5m"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#3B2E7A"/>
            <Button
                android:id="@+id/snoozeButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@null"
                android:elevation="0dp"/>
        </FrameLayout>

        <Space android:layout_width="8dp" android:layout_height="1dp"/>

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/alarm_dismiss_circle"
                android:src="@drawable/ic_close_white"
                android:scaleType="center"
                android:padding="11dp"/>
            <Button
                android:id="@+id/dismissButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@null"
                android:elevation="0dp"/>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
