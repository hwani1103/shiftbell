<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1(최소 110x40dp): 위는 앱 아이콘·오늘 근무, 아래는 수면·기상 버튼. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sleep_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sleep_widget_panel"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="1dp">

            <ImageView
                android:id="@+id/sleep_brand_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:paddingVertical="3dp"
                android:paddingHorizontal="8dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/sleep_widget_brand"/>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="1dp">

            <TextView
                android:id="@+id/sleep_shift_label"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="#FF424242"
                android:textStyle="bold"
                android:textSize="10sp"
                android:visibility="gone"/>

            <!-- 배경과 글자를 하나의 비트맵으로 그려 기기별 정렬 오차를 막는다. -->
            <ImageView
                android:id="@+id/sleep_shift_chip_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:paddingVertical="3dp"
                android:paddingHorizontal="6dp"
                android:scaleType="fitCenter"/>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sleep_action_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sleep_button_sleep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:background="@drawable/sleep_widget_button_bg"
            android:padding="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/sleep_widget_sleep"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="0.5sp"/>

        <TextView
            android:id="@+id/sleep_button_wake"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:background="@drawable/sleep_widget_button_bg_inactive"
            android:padding="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/sleep_widget_wake"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="0.5sp"/>
    </LinearLayout>
</LinearLayout>
