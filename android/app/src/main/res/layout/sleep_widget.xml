<?xml version="1.0" encoding="utf-8"?>
<!--
    ⭐ 실제 수면 기록 위젯(캘린더 위젯과 완전 별개). "오늘 근무" 한 줄 +
    "수면"/"기상" 버튼 2개를 보여준다(2026-09-01 재설계 -
    SleepWidgetProvider.kt 참고, 수면기록_자동추정_설계.md 6장).

    ⭐ 2026-09-01 후속13 - "빨리 써야 하는 위젯이니 작게" 요청으로 한 번
    컴팩트하게 줄였다가, 2026-09-13(2차)에 위젯 프레임 자체가 다시 3x2(150x110dp)로
    커짐(sleep_widget_info.xml 참고 - 일부 런처에서 그리드 셀 크기가 안 맞아
    레이아웃이 깨질 위험 때문에 프레임을 키운 것 - 내용물 크기는 그대로 둬서
    한동안 여백이 많았음).

    ⭐ 2026-09-21 - 상태 줄을 없앤 뒤 남은 세 요소(오늘 근무/수면/기상)를
    가로 한 줄로 재배치했다. 메타데이터도 공식 셀 공식과 일치하는 3x1로
    내려 작은 화면/구형 런처가 minHeight와 targetCellHeight 중 어느 쪽을
    보더라도 같은 한 행으로 계산한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sleep_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel_light"
    android:orientation="horizontal"
    android:padding="5dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.45"
        android:orientation="horizontal"
        android:gravity="start|center_vertical">

        <TextView
            android:id="@+id/sleep_shift_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:text="오늘"
            android:textColor="#FF424242"
            android:textStyle="bold"
            android:textSize="11sp"/>

        <!-- ⭐ 2026-09-13(2차) - 배경 알약 + 글자를 SleepWidgetProvider.kt의
             roundedChipBitmap()이 한 비트맵에 같이 그려서 넣음(텍스트를 별도
             TextView로 겹치던 방식은 기기마다 정렬이 어긋나는 문제가 있어
             제거함 - 위 Kotlin 파일 주석 참고). wrap_content로 비트맵 실제
             크기 그대로 표시 - scaleType 없음(늘리지 않음, 그린 그대로). -->
        <ImageView
            android:id="@+id/sleep_shift_chip_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/sleep_button_sleep"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/sleep_widget_button_bg"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:maxLines="1"
            android:text="수면"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/sleep_button_wake"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/sleep_widget_button_bg_inactive"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:maxLines="1"
            android:text="기상"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>

</LinearLayout>

</LinearLayout>
