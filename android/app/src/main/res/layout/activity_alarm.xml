<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ 2026-08-25 6차 수정 - 사용자가 직접 지정한 크기/위치 조정 + 배경을
     WaveGradientView(파도치는 그라데이션 애니메이션)로 교체. 뷰 ID(timeText/
     shiftTypeText/dismissButton/snoozeButton/rootLayout)는 전부 그대로 -
     AlarmActivity.kt의 findViewById 참조·클릭 리스너·스와이프 제스처 로직은
     하나도 안 건드림, 순수 시각 요소만 교체. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ⭐ 알람이 울리는 동안(=이 화면이 떠있는 동안) 그라데이션이 천천히
         회전하는 배경. 정적 alarm_gradient_bg 대신 씀 - WaveGradientView.kt 참고. -->
    <com.hwani1103.shiftbell.WaveGradientView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 알람 라벨 + 원형 시계 + 근무 뱃지 -->
    <LinearLayout
        android:id="@+id/alarmCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/swipeHintContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.22">

        <!-- 알람 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="알람"
            android:textSize="16sp"
            android:textColor="#3B2E7A"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_marginBottom="28dp"/>

        <!-- 원형 시계 - 숫자(42sp)는 그대로, 원 자체만 키움 -->
        <TextView
            android:id="@+id/timeText"
            android:layout_width="252dp"
            android:layout_height="252dp"
            android:gravity="center"
            android:background="@drawable/alarm_time_circle"
            android:elevation="6dp"
            android:text="09:30"
            android:textSize="42sp"
            android:textColor="#6A4FD9"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="20dp"/>

        <!-- 근무 타입 뱃지 - 살짝 키우고, 그림자(elevation) 제거 -->
        <TextView
            android:id="@+id/shiftTypeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="주간"
            android:textSize="19sp"
            android:textColor="#3B2E7A"
            android:textStyle="bold"
            android:background="@drawable/alarm_shift_badge"
            android:paddingHorizontal="30dp"
            android:paddingVertical="13dp"/>

    </LinearLayout>

    <!-- 스와이프 안내 영역 - alarmCard와 buttonContainer 사이 공간에서 65%
         지점(=화면 중앙보다 약간 아래)에 오도록 배치. 글자/아이콘 크게. -->
    <LinearLayout
        android:id="@+id/swipeHintContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/alarmCard"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.65">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_double_arrow_up"/>

        <TextView
            android:id="@+id/swipeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="위로 스와이프해서 끄기"
            android:textSize="16sp"
            android:textColor="#803B2E7A"/>
    </LinearLayout>

    <!-- 하단 버튼들 - 원형 버튼 + 아래 라벨. 순서: 스누즈 먼저, 끄기 나중
         (왼쪽→오른쪽). Button은 findViewById<Button>(Kotlin)이 요구하는
         타입이라 그대로 유지하되, 시각적으로는 투명하게 비우고 그 아래 진짜
         원형+라벨 뷰를 겹쳐서 그림(Button = 탭 영역만 담당, 클릭 리스너/로직은
         AlarmActivity.kt 그대로). -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="90dp">

        <!-- 5분 후 -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="104dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="false"
                android:focusable="false">
                <TextView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:background="@drawable/alarm_snooze_circle"
                    android:text="+5m"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#3B2E7A"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="5분 후"
                    android:textSize="16sp"
                    android:textColor="#B33B2E7A"/>
            </LinearLayout>
            <Button
                android:id="@+id/snoozeButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@null"
                android:elevation="0dp"/>
        </FrameLayout>

        <Space android:layout_width="28dp" android:layout_height="1dp"/>

        <!-- 끄기 -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="104dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="false"
                android:focusable="false">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/alarm_dismiss_circle"
                    android:src="@drawable/ic_close_white"
                    android:scaleType="center"
                    android:padding="19dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="끄기"
                    android:textSize="16sp"
                    android:textColor="#B33B2E7A"/>
            </LinearLayout>
            <Button
                android:id="@+id/dismissButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@null"
                android:elevation="0dp"/>
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
