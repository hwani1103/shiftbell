<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ 2026-08-25 - "UI 테마" 탭에서 검토/확정한 "오로라 페일" 톤으로 전면
     교체(앱 아이콘/다음알람탭과 동일한 그라데이션+색상). 뷰 ID(timeText/
     shiftTypeText/dismissButton/snoozeButton/rootLayout)는 전부 그대로 -
     AlarmActivity.kt의 findViewById 참조·클릭 리스너·스와이프 제스처 로직은
     하나도 안 건드림, 순수 시각 요소만 교체. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alarm_gradient_bg">

    <!-- 알람 라벨 + 원형 시계 + 근무 뱃지 -->
    <LinearLayout
        android:id="@+id/alarmCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/swipeHintContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.22">

        <!-- 알람 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="알람"
            android:textSize="14sp"
            android:textColor="#3B2E7A"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_marginBottom="28dp"/>

        <!-- 원형 시계 -->
        <TextView
            android:id="@+id/timeText"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:gravity="center"
            android:background="@drawable/alarm_time_circle"
            android:elevation="6dp"
            android:text="09:30"
            android:textSize="42sp"
            android:textColor="#6A4FD9"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="20dp"/>

        <!-- 근무 타입 뱃지 -->
        <TextView
            android:id="@+id/shiftTypeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="주간"
            android:textSize="17sp"
            android:textColor="#3B2E7A"
            android:textStyle="bold"
            android:background="@drawable/alarm_shift_badge"
            android:elevation="3dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"/>

    </LinearLayout>

    <!-- 스와이프 안내 영역 -->
    <LinearLayout
        android:id="@+id/swipeHintContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/alarmCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <!-- 스와이프 텍스트 -->
        <TextView
            android:id="@+id/swipeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="화면을 스와이프하여 끄기"
            android:textSize="18sp"
            android:textColor="#3B2E7A"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- 스와이프 가이드 (좌우 화살표 + 원) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- 왼쪽 화살표 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◄"
                android:textSize="32sp"
                android:textColor="#8C7FC7"/>

            <!-- 중앙 원 -->
            <View
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/swipe_guide_circle"/>

            <!-- 오른쪽 화살표 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="►"
                android:textSize="32sp"
                android:textColor="#8C7FC7"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 하단 버튼들 - "UI 테마" 탭 확정 레이아웃 그대로: 원형 버튼 + 아래 라벨
         (사각 필 버튼이 아님). 순서도 동일(스누즈 먼저, 끄기 나중 - 왼쪽→오른쪽).
         Button은 findViewById<Button>(Kotlin)이 요구하는 타입이라 그대로 유지하되,
         시각적으로는 투명하게 비우고 그 아래 진짜 원형+라벨 뷰를 겹쳐서 그림
         (Button = 탭 영역만 담당, 클릭 리스너/로직은 AlarmActivity.kt 그대로). -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="100dp">

        <!-- 5분 후 -->
        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="88dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="false"
                android:focusable="false">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:background="@drawable/alarm_snooze_circle"
                    android:text="+5m"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#3B2E7A"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="5분 후"
                    android:textSize="11sp"
                    android:textColor="#B33B2E7A"/>
            </LinearLayout>
            <Button
                android:id="@+id/snoozeButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@null"
                android:elevation="0dp"/>
        </FrameLayout>

        <Space android:layout_width="28dp" android:layout_height="1dp"/>

        <!-- 끄기 -->
        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="88dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="false"
                android:focusable="false">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/alarm_dismiss_circle"
                    android:src="@drawable/ic_close_white"
                    android:scaleType="center"
                    android:padding="17dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="끄기"
                    android:textSize="11sp"
                    android:textColor="#B33B2E7A"/>
            </LinearLayout>
            <Button
                android:id="@+id/dismissButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:stateListAnimator="@null"
                android:elevation="0dp"/>
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
