<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ 2026-08-25 6차 수정 - 사용자가 직접 지정한 크기/위치 조정 + 배경을
     WaveGradientView(파도치는 그라데이션 애니메이션)로 교체. 뷰 ID(timeText/
     shiftTypeText/dismissButton/snoozeButton/rootLayout)는 전부 그대로 -
     AlarmActivity.kt의 findViewById 참조·클릭 리스너·스와이프 제스처 로직은
     하나도 안 건드림, 순수 시각 요소만 교체. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ⭐ 알람이 울리는 동안(=이 화면이 떠있는 동안) 그라데이션이 천천히
         회전하는 배경. 정적 alarm_gradient_bg 대신 씀 - WaveGradientView.kt 참고. -->
    <com.hwani1103.shiftbell.WaveGradientView
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- 알람 라벨 + 원형 시계 + 근무 뱃지 -->
    <LinearLayout
        android:id="@+id/alarmCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/swipeHintContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.06">

        <!-- ⭐ 2026-08-25 - "알람" 라벨 텍스트 제거함(원 위에 굳이 필요 없다는
             피드백) - 이 TextView는 id가 없어 AlarmActivity.kt에서 참조하는
             곳이 없었음, 안전하게 삭제. 라벨이 사라져 생긴 여유만큼 원/숫자를
             더 키우고(276dp/46sp), 위로도 살짝 올림(marginTop 48→40dp,
             bias 0.1→0.06). -->

        <!-- 원형 시계 - 라벨 제거로 생긴 여유만큼 원/숫자 확대, 배지와의
             간격도 더 띄움 -->
        <TextView
            android:id="@+id/timeText"
            android:layout_width="276dp"
            android:layout_height="276dp"
            android:gravity="center"
            android:background="@drawable/alarm_time_circle"
            android:elevation="6dp"
            android:text="09:30"
            android:textSize="46sp"
            android:textColor="#6A4FD9"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="32dp"/>

        <!-- 근무 타입 뱃지 - 살짝 키우고, 그림자(elevation) 제거 -->
        <TextView
            android:id="@+id/shiftTypeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alarm_default_label"
            android:textSize="20sp"
            android:textColor="#3B2E7A"
            android:textStyle="bold"
            android:background="@drawable/alarm_shift_badge"
            android:paddingHorizontal="30dp"
            android:paddingVertical="13dp"/>

    </LinearLayout>

    <!-- 스와이프 안내 영역 - alarmCard와 buttonContainer 사이 공간에서 65%
         지점(=화면 중앙보다 약간 아래)에 오도록 배치. 글자/아이콘 크게. -->
    <LinearLayout
        android:id="@+id/swipeHintContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/alarmCard"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.65">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_double_arrow_up"/>

        <TextView
            android:id="@+id/swipeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/alarm_swipe_hint"
            android:textSize="16sp"
            android:textColor="#803B2E7A"/>
    </LinearLayout>

    <include layout="@layout/alarm_controls" android:id="@+id/buttonContainer"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginBottom="16dp"
        app:layout_constraintWidth_max="352dp" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
