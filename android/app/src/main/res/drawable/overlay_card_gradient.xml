<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ 2026-08-25 - "오로라 페일" 그라데이션으로 교체(잠금화면/아이콘과 동일,
     alarm_gradient_bg.xml 상단 주석의 angle 설명 참고). 이 오버레이는
     AlarmOverlayService.kt에서 gravity=TOP, y=0, width=MATCH_PARENT로 화면
     맨 위에 딱 붙여서 띄우므로("UI 테마" 탭 _overlayCard와 동일 가정), 위쪽
     모서리는 각지고 아래쪽만 둥글게(bottomLeft/bottomRight만 radius). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#DACEF9"
        android:centerColor="#CEDEFC"
        android:endColor="#BFF5F1"
        android:angle="315"/>
    <corners
        android:bottomLeftRadius="24dp"
        android:bottomRightRadius="24dp"
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp"/>
</shape>
