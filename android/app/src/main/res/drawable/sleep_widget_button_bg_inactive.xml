<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ 수면 위젯 - 지금 상태에서 의미 없는 쪽 버튼(예: 이미 수면 중일 때의 "수면"
     버튼)에 쓰는 회색 배경. sleep_widget_button_bg.xml(강조색)과 짝을 이룸 -
     SleepWidgetProvider.buildRemoteViews()가 상태에 따라 두 버튼에 번갈아 적용. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFBDBDBD"/>
    <!-- 2026-09-22 - 알약 모양(반지름이 높이의 절반을 넘으면 안드로이드가 알아서 절반으로 자른다) -->
    <corners android:radius="20dp"/>
</shape>
