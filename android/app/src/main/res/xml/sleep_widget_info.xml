<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ 실제 수면 기록 위젯 메타데이터 - 캘린더 위젯(calendar_widget_info.xml)과 완전
     별개. 2026-09-01 - "오늘: OO / 상태: OO" 두 줄 + 버튼 2개(수면/기상)를 담기
     위해 기존 2x1(110x40dp) 최소 크기에서 3x2(180x110dp)로 키웠었는데, "빨리
     써야 하는 위젯인데 너무 커졌다"는 후속 피드백으로 sleep_widget.xml의
     padding/텍스트 크기를 전부 줄여서 다시 컴팩트하게 만들었음.

     ⭐ 2026-09-13 - "에뮬레이터/다른 폰에서 위젯이 위아래로 불필요하게 크다"는
     사용자 신고로 재점검: 위 컴팩트화 때 sleep_widget.xml(내용물)만 줄이고 이
     파일의 minWidth/minHeight는 "2x1과 3x2의 중간"(150x72dp)이라는 애매한
     값으로 남겨뒀던 게 근본 원인이었음. 안드로이드 공식 그리드 셀 크기 공식은
     `min = 70*n - 30`(n=칸 수)인데, 72dp는 1행(40dp) 기준을 넘고 2행(110dp)
     기준에는 못 미쳐 - targetCellHeight="1"이라고 명시해도, 이 target 값을
     지원 안 하는(구형 방식으로 minHeight만 보고 행 수를 역산하는) 런처는
     72dp를 "2행이 필요하다"고 반올림해버림. 반면 target 값을 우선 적용하는
     런처(사용자 실기기)는 선언한 대로 1행으로 딱 맞게 보여줬던 것 - 런처마다
     서로 다른 걸 보게 되는 근본 원인이 바로 이 minHeight/targetCellHeight
     불일치였음. 내용물이 실제로 3줄(근무/상태/버튼)이라 1행(40dp)에는 안
     들어가는 게 이미 확인된 전례가 있으므로(그래서 원래 3x2로 키웠던 것),
     "2행이 필요하다"는 쪽을 정직하게 선언하는 방향으로 통일함 -
     minHeight/targetCellHeight 모두 2행 기준(110dp)으로, minWidth가 이미
     암시하던 3칸 기준에 맞춰 targetCellWidth도 3으로 맞춤. 이제 어떤 런처가
     어느 필드를 보든 항상 같은 3x2로 귀결되어야 함.
     ⚠️ 사용자 실기기에서 이 변경 후 렌더링이 그대로/개선됐는지 확인 필요(런처별
     실제 그리드 셀 물리적 높이는 앱 코드로 알 수 없어 100% 장담은 못 함). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="150dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/sleep_widget"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    android:description="@string/sleep_widget_description"
    android:previewLayout="@layout/sleep_widget" />
