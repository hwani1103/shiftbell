  "sleepText095": "नींद का एक रिकॉर्ड अभी जारी है",
  "sleepText096": "काम खत्म होने ({arg0}) के बाद अभी नींद दर्ज नहीं है",
  "sleepText097": "कल ({arg0}) की नींद: {arg1}{arg2}",
  "sleepText098": "कल ({arg0}) की नींद दर्ज नहीं है",
  "sleepText099": "बीते कल",
  "sleepText100": "बीते परसों",
  "sleepText101": "{arg0}, {arg1}: {arg2} नींद, आपके {arg3} के औसत से {arg4} कम (पिछले 30 दिनों के {arg5} दिनों पर आधारित)",
  "sleepText102": "हाल में {arg0} वाले दिनों में आपकी नींद सामान्य से कम थी। अगली बार सोने का मौका मिले तो रिकवरी के लिए थोड़ा अधिक समय रखें।",
  "sleepText103": "शिफ़्ट के बीच आराम: {arg0} ({arg1} खत्म → {arg2} शुरू){arg3}",
  "sleepText104": "लगातार {arg0} रात की शिफ़्ट के बाद",
  "sleepText105": "रात की लगातार {arg0}वीं शिफ़्ट",
  "sleepText106": "बिना छुट्टी के बहुत लंबे समय तक लगातार रात की शिफ़्ट के बाद",
  "sleepText107": "बिना छुट्टी के बहुत लंबे समय से रात की शिफ़्ट जारी है",
  "sleepText108": "{arg0}। लगातार शिफ़्ट के साथ थकान और गलतियाँ बढ़ सकती हैं।",
  "sleepText109": "(कुल लगातार काम का {arg0}वाँ दिन)",
  "sleepText110": "कम से कम {arg0} घंटे की शिफ़्ट लगातार {arg1} दिनों से{arg2}",
  "sleepText111": "कम से कम {arg0} घंटे की शिफ़्ट बहुत लंबे समय से बिना छुट्टी जारी है",
  "sleepText112": "{arg0} घंटे की शिफ़्ट {arg1} से जारी है। शेड्यूल बदलना संभव हो तो इसके बाद लगभग {arg2} दिन की छुट्टी पर विचार करें।",
  "sleepText113": "यह लगातार काम का {arg0}वाँ दिन है। छुट्टी न मिलने से थकान बढ़ सकती है।",
  "sleepText114": "बहुत लंबे समय से बिना छुट्टी काम जारी है। इससे थकान बढ़ सकती है।",
  "sleepText115": "लगातार काम के कई दिन हो गए हैं। शेड्यूल बदलना संभव हो तो कम से कम एक दिन की छुट्टी रखने की कोशिश करें।",
  "sleepText116": "लगातार काम का {arg0}वाँ दिन",
  "sleepText117": "बहुत लंबे समय से बिना छुट्टी काम जारी है",
  "sleepText118": "पिछले 7 दिनों में काम: {arg0}, जो आपके सामान्य साप्ताहिक लगभग {arg1} से {arg2} अधिक है",
  "sleepText119": "पिछले 7 दिनों में काम के घंटे सामान्य से काफ़ी अधिक हैं। संभव हो तो अतिरिक्त काम कम करें और आराम को प्राथमिकता दें।",
  "sleepText120": "इस हफ़्ते आपका काम सामान्य से अधिक है। संभव हो तो अतिरिक्त काम कम करें और आराम के लिए समय रखें।",
  "sleepText121": "पीछे की ओर शिफ़्ट बदलने ({arg0} → {arg1}) की आदत डालना, आगे की ओर बदलने से कठिन हो सकता है।",
  "sleepText122": "{arg0} के बाद कॉफ़ी और एनर्जी ड्रिंक से बचें (सोने का लक्ष्य: {arg1})।",
  "sleepText123": "सोने के तय समय ({arg0}) में 6 घंटे से कम बचे हैं। अब से कॉफ़ी और एनर्जी ड्रिंक से बचें।",
  "sleepText124": "काम खत्म होने और अगली शिफ़्ट के बीच सोने के लिए बहुत कम समय है। संभव हो तो शेड्यूल बदलने या काम के दौरान छोटी छुट्टी लेने के बारे में पूछें।",
  "sleepText125": "काम के बाद सोने के लिए केवल {arg0}–{arg1}, लगभग {arg2}, का समय है। काम खत्म होने पर नींद को प्राथमिकता दें।",
  "sleepText126": "काम के बाद नींद को प्राथमिकता दें। लगभग {arg0} पर सोने से अगली शिफ़्ट की तैयारी से पहले कम से कम 7 घंटे मिलते हैं।",
  "sleepText127": "काम के बाद दूसरे कामों से पहले नींद को प्राथमिकता दें।",
  "sleepText128": "पिछले 24 घंटों में दर्ज नींद सुझाई गई मात्रा से कम है। यह शिफ़्ट खत्म होने पर (लगभग {arg0}) नींद को प्राथमिकता दें।",
  "sleepText129": "रात की शिफ़्ट के बाद नींद को प्राथमिकता दें। ",
  "sleepText130": "और {arg0} सोने के लिए",
  "sleepText131": "7 घंटे सोने के लिए",
  "sleepText132": "{arg0}अगली शिफ़्ट ({arg1}) से पहले {arg2}, अधिकतम {arg3} तक सोने चले जाएँ।",
  "sleepText133": "{arg0}अभी सोने पर भी काम की तैयारी से पहले अधिकतम {arg1} मिलेंगे। दूसरे काम टालकर नींद को प्राथमिकता दें।",
  "sleepText134": "सोने का समय पास है। अब से कॉफ़ी और एनर्जी ड्रिंक से बचें।",
  "sleepText135": "रात की शिफ़्ट के बाद दूसरे कामों से पहले नींद को प्राथमिकता दें।",
  "sleepText136": "आज कम से कम 7 घंटे सोने का लक्ष्य रखें।",
  "sleepText137": "बीते कल तक लगातार {arg0} रात की शिफ़्ट",
  "sleepText138": "बिना छुट्टी के बहुत लंबे समय से जारी रात की शिफ़्ट का क्रम बीते कल खत्म हुआ",
  "sleepText139": "रात की शिफ़्ट के बाद आज छुट्टी है। मिलने-जुलने या घर के कामों से पहले रिकवरी के लिए नींद लें।",
  "sleepText140": "अगली शिफ़्ट ({arg0}, {arg1}) से पहले 7 घंटे सोने के लिए अधिकतम {arg2} तक सोने चले जाएँ।",
  "sleepText141": "हाल में दर्ज नींद 7 घंटे के सुझाए लक्ष्य से कम थी। छुट्टी के दिनों में सोने के लिए अधिक समय रखें।",
  "sleepText142": "पिछले 7 दिनों की औसत नींद: {arg0} ({arg1} दर्ज दिनों पर आधारित){arg2}",
  "sleepText143": "बहुत लंबे समय से बिना छुट्टी रात की शिफ़्ट जारी है",
  "sleepText144": "यह रात की लगातार {arg0}वीं शिफ़्ट है",
  "sleepText145": "{arg0}। गाड़ी चलाते या जोखिम भरा काम करते समय अतिरिक्त सावधानी रखें।",
  "sleepText146": "पिछले 2 हफ़्तों में नींद दर्ज नहीं है, इसलिए ये सुझाव केवल शिफ़्ट के शेड्यूल पर आधारित हैं।",
  "sleepText147": "पिछले 7 दिनों में केवल {arg0} दिन नींद दर्ज है, इसलिए औसत नहीं निकाला गया।",
  "sleepText148": "{arg0} के शुरू और खत्म होने का समय नहीं है, इसलिए वे दिन गणना में शामिल नहीं हैं। सेटिंग → काम के घंटे और ओवरटाइम में समय दर्ज करें।",
  "sleepText149": "पुष्टि न होने के कारण शामिल नहीं किए गए नींद अनुमान: {arg0}।",
  "sleepText150": "सामान्य",
  "sleepText151": "इस पैटर्न में औसतन हर हफ़्ते लगभग {arg0} काम है। यह नर्सिंग के लिए 60 घंटे की सिफ़ारिश और यूरोपीय संघ के 48 घंटे के संदर्भ तक पहुँचता या उनसे अधिक है। ये स्रोतों से तुलना हैं, स्थानीय क़ानून के पालन का निर्णय नहीं।",
  "sleepText152": "इस पैटर्न में औसतन हर हफ़्ते लगभग {arg0} काम है, जो यूरोपीय संघ के 48 घंटे के संदर्भ तक पहुँचता या उससे अधिक है। यह तुलना तय नहीं करती कि आप पर काम के घंटों के कौन से नियम लागू हैं।",
  "sleepText186": "शिफ़्ट बदलने की दिशा",
