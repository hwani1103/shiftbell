  "scheduleDeleteConfirmTitle": "Excluir este compromisso?",
  "scheduleDeleteConfirmBody": "Compromissos excluídos não podem ser recuperados.",
  "scheduleEditTitle": "Editar compromisso",
  "scheduleNewTitle": "Novo compromisso",
  "scheduleContentFieldLabel": "Detalhes",
  "scheduleTimeSectionLabel": "Horário",
  "scheduleNotifySectionLabel": "Notificação",
  "scheduleNotifyToggleLabel": "Lembrar deste compromisso",
  "scheduleNotifyDescription": "Você receberá uma notificação que segue a configuração de som, vibração ou silêncio do aparelho.",
  "scheduleNotifyOffsetQuestion": "Quando lembrar?",
  "scheduleNotifyOffsetOnTime": "No início",
