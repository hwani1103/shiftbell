  "teamSetupModeTitle": "Escolha como configurar",
  "teamSetupShared": "Todas as equipes usam o mesmo ciclo",
  "teamSetupSharedHint": "Defina a posição de cada equipe em um ciclo comum.",
  "teamSetupIndividual": "Usar um ciclo diferente por equipe",
  "teamSetupIndividualHint": "Defina um ciclo ou uma escala semanal para cada equipe.",
  "teamRuleBase": "Usar o ciclo base",
  "teamRuleCycle": "Usar outro ciclo",
  "teamRuleWeekly": "Definir por dia da semana",
  "teamRuleTitle": "Definir escala",
