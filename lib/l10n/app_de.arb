  "themeLabPreviewSheetHint": "In der App kannst du hier Notizen und Überstunden ansehen und bearbeiten.",
  "themeLabOtDetailNotice": "In der App öffnet ein Tippen hier die Überstundenliste",
  "dismissAlarmConfirmed": "Ausgeschaltet",
