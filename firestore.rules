// firestore.rules
//
// ⭐ 친구공유 v1 보안 규칙 (친구공유_v1_스펙.md 참고). Firebase 콘솔 → Firestore Database
// → 규칙 탭에 그대로 붙여넣고 배포하면 됨. 사용자가 직접 해야 하는 일(친구공유_v1_스펙.md
// "사용자가 직접 해야 할 일" 참고) 중 하나 - Claude가 대신 배포할 수 없음.
//
// ⭐ 설계:
// - 문서 ID(ownerId) = Firebase 익명 인증(Anonymous Auth) uid. 콘솔의 Authentication →
//   Sign-in method에서 "Anonymous"를 켜야 앱이 로그인할 수 있음(무료, Spark 포함).
// - read(get): 문서 ID를 아는 사람이면 누구나 - 공유 코드/링크 자체가 "이 ID를 안다"는
//   증거라 별도 인증 없이 열람 가능해야 함(앱 미설치 웹뷰어 방문자도 봐야 하므로).
//   list는 아예 규칙을 정의하지 않아 기본값(거부)으로 남겨둠 - 전체 목록 열람 원천 차단.
// - write: request.auth.uid가 문서 ID와 일치할 때만. 코드를 받은 친구도 문서 ID는
//   알지만 자기 uid는 다르므로 절대 덮어쓸 수 없음 - "문서 ID = read용 열쇠,
//   uid = write용 열쇠"로 역할이 분리됨.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /friend_schedules/{ownerId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == ownerId;
      allow delete: if request.auth != null && request.auth.uid == ownerId;
    }

    // ⭐ 2026-08-20 추가 - "새 버전이 있어요" 안내를 Play In-App Update API(전파 지연에
    // 취약함) 대신 개발자가 직접 통제하는 원격 설정값으로 판단하기 위한 컬렉션
    // (update_service.dart 참고). 앱이 켜질 때마다 인증 여부와 무관하게 누구나 읽을 수
    // 있어야 하므로(익명 로그인은 친구공유를 실제로 쓸 때만 일어남) get을 열어두되,
    // write는 클라이언트에서 절대 못 하게 막음 - 값은 Firebase 콘솔에서 개발자가 직접
    // 수정함(문서 하나뿐이라 list도 열 필요 없음).
    match /app_config/{document} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // ⭐ 2026-09-01 추가 - "교대근무 건강 & 수면 관리 Tip"(컨디션 탭, 사용자
    // 요청). app_config와 같은 "읽기 전용 원격 설정" 패턴이지만, 문서 ID를
    // 미리 알 수 없는 여러 개의 팁 문서를 통째로 조회해야 해서 list도 열어둠
    // (app_config는 문서 하나뿐이라 get만 허용했던 것과 차이점). 값은 이번에도
    // Firebase 콘솔에서 개발자가 직접 추가/수정 - 클라이언트 write는 항상 거부.
    match /health_tips/{tipId} {
      allow get: if true;
      allow list: if true;
      allow write: if false;
    }

    // ⭐ 2026-09-22 추가 - 관리자 대시보드(admin_dashboard/)가 읽는 집계 문서(summary/series/events).
    // GA4에서 뽑은 운영 지표라 관리자 본인만 읽을 수 있어야 한다.
    //  - email이 관리자 이메일이고 email_verified가 true인 계정만 read 허용.
    //    ⚠️ email_verified 조건이 핵심이다: 이 프로젝트는 이메일/비밀번호 가입이 열려 있을 수 있어서(익명 로그인용 Auth를 같이 씀)
    //    관리자 계정을 만들기 전에 누군가 같은 이메일로 먼저 가입해 버리면 규칙을 통과할 수 있다. 관리자 계정은 Admin SDK로
    //    emailVerified:true로 만들기 때문에(sync/admin-user.mjs) 가로채기 계정은 통과하지 못한다.
    //  - write는 클라이언트에서 전부 거부. 값은 sync/sync.mjs가 Admin SDK로만 쓴다(규칙을 우회함).
    match /dashboard/{document} {
      allow get: if request.auth != null
                 && request.auth.token.email == 'rlaworms0905@naver.com'
                 && request.auth.token.email_verified == true;
      allow list, write: if false;
    }

    // ⭐ 그 외 모든 컬렉션은 기본 거부 - 이 앱은 friend_schedules/app_config/health_tips 세 개만 씀.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
