{
  "flutter": {"platforms": {"dart": {"lib/firebase_options.dart": {"projectId": "shiftbell-29f31", "configurations": {"android": "1:52312015153:android:05c0a871247af532147010", "web": "1:52312015153:web:a73efa3a9ef88b09147010"}}}}},
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "**", "destination": "/index.html"}
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "**/*.@(js|mjs|wasm|json|png|jpg|svg|ico|otf|ttf|woff|woff2|bin|frag)",
        "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]
      },
      {
        "source": "**/@(flutter_bootstrap.js|flutter.js|flutter_service_worker.js|version.json|manifest.json)",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ]
  }
}
